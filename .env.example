# Copy these into Vercel > Project > Settings > Environment Variables.
# Never put these in the front-end files or commit real values.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase > Project Settings > API > "service_role" key (secret, server only)
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (e.g. run: openssl rand -hex 32). Signs host login tokens.
HOST_SECRET=

# Public URL of your deployed site, no trailing slash. Used in emailed links.
SITE_URL=https://your-app.vercel.app

# ---- Email: pick ONE option ----

# Option A: Resend (needs a verified domain to email other people)
RESEND_API_KEY=
MAIL_FROM=Embers <hello@yourdomain.com>

# Option B: Gmail (works for a weekend gathering with no domain).
# Turn on 2-step verification, then create an App Password at myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: if set, only people who know this can create a new gathering on your site
CREATE_PASSCODE=

# Set to false to skip the email code step when guests join (easier, but easier to cheat)
REQUIRE_VERIFY=true
